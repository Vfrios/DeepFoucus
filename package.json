{
  "name": "wall-dashboard",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @wall/backend dev\" \"pnpm --filter @wall/frontend dev\"",
    "build": "npm -w frontend run build && npm -w backend run build",
    "test": "npm -w backend run test",
    "start": "node backend/dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^9.5.1"
  }
}
